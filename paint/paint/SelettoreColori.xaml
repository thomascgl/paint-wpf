<Window x:Class="paint.SelettoreColori"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:paint"
        mc:Ignorable="d"
        Title="Selettore Colori" Height="290" Width="500" Icon="/Immagini/RGB_ColorSpectrum.png">
    <Window.Resources>
        <Style x:Key="GlassPanelStyle" TargetType="Border">
            <!-- Forma -->
            <Setter Property="CornerRadius" Value="25"/>
            <Setter Property="BorderThickness" Value="1"/>

            <!-- Colori vetro -->
            <Setter Property="Background" Value="#70FFFFFF"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>

            <!-- Rendering -->
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>

            <!-- Ombra -->
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="25"
                      ShadowDepth="0"
                      Color="Black"
                      Opacity="0.25"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Background="#FFC3C3C3">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="171*"/>
            <ColumnDefinition Width="79*"/>
        </Grid.ColumnDefinitions>
        <TabControl HorizontalAlignment="Left" Margin="10,5,0,0" Width="264" IsSynchronizedWithCurrentItem="True" Height="246" VerticalAlignment="Top">
            <TabItem Header="default">
                <Grid Background="#FFE5E5E5">
                    <Grid HorizontalAlignment="Center" Height="162" VerticalAlignment="Center" Width="212">
                        <!-- RIGA 1 -->
                        <Rectangle HorizontalAlignment="Left" Height="20" Margin="10,10,0,0" Stroke="Black" VerticalAlignment="Top" Width="20" Fill="#000000" MouseLeftButtonDown="quadrato_MouseLeftButtonDown"/>
                        <Rectangle HorizontalAlignment="Left" Height="20" Margin="160,10,0,0" Stroke="Black" VerticalAlignment="Top" Width="20" Fill="#008080" MouseLeftButtonDown="quadrato_MouseLeftButtonDown"/>
                        <Rectangle HorizontalAlignment="Left" Height="20" Margin="135,10,0,0" Stroke="Black" VerticalAlignment="Top" Width="20" Fill="#800080" MouseLeftButtonDown="quadrato_MouseLeftButtonDown"/>
                        <Rectangle HorizontalAlignment="Left" Height="20" Margin="110,10,0,0" Stroke="Black" VerticalAlignment="Top" Width="20" Fill="#000080" MouseLeftButtonDown="quadrato_MouseLeftButtonDown"/>
                        <Rectangle HorizontalAlignment="Left" Height="20" Margin="85,10,0,0" Stroke="Black" VerticalAlignment="Top" Width="20" Fill="#808000" MouseLeftButtonDown="quadrato_MouseLeftButtonDown"/>
                        <Rectangle HorizontalAlignment="Left" Height="20" Margin="60,10,0,0" Stroke="Black" VerticalAlignment="Top" Width="20" Fill="#008000" MouseLeftButtonDown="quadrato_MouseLeftButtonDown"/>
                        <Rectangle HorizontalAlignment="Left" Height="20" Margin="35,10,0,0" Stroke="Black" VerticalAlignment="Top" Width="20" Fill="#800000" MouseLeftButtonDown="quadrato_MouseLeftButtonDown"/>
                        <Rectangle HorizontalAlignment="Left" Height="20" Margin="185,10,0,0" Stroke="Black" VerticalAlignment="Top" Width="20" Fill="#808080" MouseLeftButtonDown="quadrato_MouseLeftButtonDown"/>

                        <!-- RIGA 2 -->
                        <Rectangle HorizontalAlignment="Left" Height="20" Margin="10,35,0,0" Stroke="Black" VerticalAlignment="Top" Width="20" Fill="#C0C0C0" MouseLeftButtonDown="quadrato_MouseLeftButtonDown"/>
                        <Rectangle HorizontalAlignment="Left" Height="20" Margin="160,35,0,0" Stroke="Black" VerticalAlignment="Top" Width="20" Fill="#FF0000" MouseLeftButtonDown="quadrato_MouseLeftButtonDown"/>
                        <Rectangle HorizontalAlignment="Left" Height="20" Margin="135,35,0,0" Stroke="Black" VerticalAlignment="Top" Width="20" Fill="#00FF00" MouseLeftButtonDown="quadrato_MouseLeftButtonDown"/>
                        <Rectangle HorizontalAlignment="Left" Height="20" Margin="110,35,0,0" Stroke="Black" VerticalAlignment="Top" Width="20" Fill="#FFFF00" MouseLeftButtonDown="quadrato_MouseLeftButtonDown"/>
                        <Rectangle HorizontalAlignment="Left" Height="20" Margin="85,35,0,0" Stroke="Black" VerticalAlignment="Top" Width="20" Fill="#0000FF" MouseLeftButtonDown="quadrato_MouseLeftButtonDown"/>
                        <Rectangle HorizontalAlignment="Left" Height="20" Margin="60,35,0,0" Stroke="Black" VerticalAlignment="Top" Width="20" Fill="#FF00FF" MouseLeftButtonDown="quadrato_MouseLeftButtonDown"/>
                        <Rectangle HorizontalAlignment="Left" Height="20" Margin="35,35,0,0" Stroke="Black" VerticalAlignment="Top" Width="20" Fill="#00FFFF" MouseLeftButtonDown="quadrato_MouseLeftButtonDown"/>
                        <Rectangle HorizontalAlignment="Left" Height="20" Margin="185,35,0,0" Stroke="Black" VerticalAlignment="Top" Width="20" Fill="#FFFFFF" MouseLeftButtonDown="quadrato_MouseLeftButtonDown"/>

                        <!-- RIGA 3 -->
                        <Rectangle HorizontalAlignment="Left" Height="20" Margin="10,60,0,0" Stroke="Black" VerticalAlignment="Top" Width="20" Fill="#804040" MouseLeftButtonDown="quadrato_MouseLeftButtonDown"/>
                        <Rectangle HorizontalAlignment="Left" Height="20" Margin="160,60,0,0" Stroke="Black" VerticalAlignment="Top" Width="20" Fill="#FF8080" MouseLeftButtonDown="quadrato_MouseLeftButtonDown"/>
                        <Rectangle HorizontalAlignment="Left" Height="20" Margin="135,60,0,0" Stroke="Black" VerticalAlignment="Top" Width="20" Fill="#80FF80" MouseLeftButtonDown="quadrato_MouseLeftButtonDown"/>
                        <Rectangle HorizontalAlignment="Left" Height="20" Margin="110,60,0,0" Stroke="Black" VerticalAlignment="Top" Width="20" Fill="#FFFF80" MouseLeftButtonDown="quadrato_MouseLeftButtonDown"/>
                        <Rectangle HorizontalAlignment="Left" Height="20" Margin="85,60,0,0" Stroke="Black" VerticalAlignment="Top" Width="20" Fill="#8080FF" MouseLeftButtonDown="quadrato_MouseLeftButtonDown"/>
                        <Rectangle HorizontalAlignment="Left" Height="20" Margin="60,60,0,0" Stroke="Black" VerticalAlignment="Top" Width="20" Fill="#FF80FF" MouseLeftButtonDown="quadrato_MouseLeftButtonDown"/>
                        <Rectangle HorizontalAlignment="Left" Height="20" Margin="35,60,0,0" Stroke="Black" VerticalAlignment="Top" Width="20" Fill="#80FFFF" MouseLeftButtonDown="quadrato_MouseLeftButtonDown"/>
                        <Rectangle HorizontalAlignment="Left" Height="20" Margin="185,60,0,0" Stroke="Black" VerticalAlignment="Top" Width="20" Fill="#FFFFFF" MouseLeftButtonDown="quadrato_MouseLeftButtonDown"/>

                        <!-- RIGA 4 -->
                        <Rectangle HorizontalAlignment="Left" Height="20" Margin="10,85,0,0" Stroke="Black" VerticalAlignment="Top" Width="20" Fill="#400000" MouseLeftButtonDown="quadrato_MouseLeftButtonDown"/>
                        <Rectangle HorizontalAlignment="Left" Height="20" Margin="160,85,0,0" Stroke="Black" VerticalAlignment="Top" Width="20" Fill="#800040" MouseLeftButtonDown="quadrato_MouseLeftButtonDown"/>
                        <Rectangle HorizontalAlignment="Left" Height="20" Margin="135,85,0,0" Stroke="Black" VerticalAlignment="Top" Width="20" Fill="#004000" MouseLeftButtonDown="quadrato_MouseLeftButtonDown"/>
                        <Rectangle HorizontalAlignment="Left" Height="20" Margin="110,85,0,0" Stroke="Black" VerticalAlignment="Top" Width="20" Fill="#404000" MouseLeftButtonDown="quadrato_MouseLeftButtonDown"/>
                        <Rectangle HorizontalAlignment="Left" Height="20" Margin="85,85,0,0" Stroke="Black" VerticalAlignment="Top" Width="20" Fill="#000040" MouseLeftButtonDown="quadrato_MouseLeftButtonDown"/>
                        <Rectangle HorizontalAlignment="Left" Height="20" Margin="60,85,0,0" Stroke="Black" VerticalAlignment="Top" Width="20" Fill="#400040" MouseLeftButtonDown="quadrato_MouseLeftButtonDown"/>
                        <Rectangle HorizontalAlignment="Left" Height="20" Margin="35,85,0,0" Stroke="Black" VerticalAlignment="Top" Width="20" Fill="#004040" MouseLeftButtonDown="quadrato_MouseLeftButtonDown"/>
                        <Rectangle HorizontalAlignment="Left" Height="20" Margin="185,85,0,0" Stroke="Black" VerticalAlignment="Top" Width="20" Fill="#404040" MouseLeftButtonDown="quadrato_MouseLeftButtonDown"/>

                        <!-- RIGA 5 -->
                        <Rectangle HorizontalAlignment="Left" Height="20" Margin="10,110,0,0" Stroke="Black" VerticalAlignment="Top" Width="20" Fill="#C00000" MouseLeftButtonDown="quadrato_MouseLeftButtonDown"/>
                        <Rectangle HorizontalAlignment="Left" Height="20" Margin="160,110,0,0" Stroke="Black" VerticalAlignment="Top" Width="20" Fill="#FF4040" MouseLeftButtonDown="quadrato_MouseLeftButtonDown"/>
                        <Rectangle HorizontalAlignment="Left" Height="20" Margin="135,110,0,0" Stroke="Black" VerticalAlignment="Top" Width="20" Fill="#40FF40" MouseLeftButtonDown="quadrato_MouseLeftButtonDown"/>
                        <Rectangle HorizontalAlignment="Left" Height="20" Margin="110,110,0,0" Stroke="Black" VerticalAlignment="Top" Width="20" Fill="#FFFF40" MouseLeftButtonDown="quadrato_MouseLeftButtonDown"/>
                        <Rectangle HorizontalAlignment="Left" Height="20" Margin="85,110,0,0" Stroke="Black" VerticalAlignment="Top" Width="20" Fill="#4040FF" MouseLeftButtonDown="quadrato_MouseLeftButtonDown"/>
                        <Rectangle HorizontalAlignment="Left" Height="20" Margin="60,110,0,0" Stroke="Black" VerticalAlignment="Top" Width="20" Fill="#FF40FF" MouseLeftButtonDown="quadrato_MouseLeftButtonDown"/>
                        <Rectangle HorizontalAlignment="Left" Height="20" Margin="35,110,0,0" Stroke="Black" VerticalAlignment="Top" Width="20" Fill="#40FFFF" MouseLeftButtonDown="quadrato_MouseLeftButtonDown"/>
                        <Rectangle HorizontalAlignment="Left" Height="20" Margin="185,110,0,0" Stroke="Black" VerticalAlignment="Top" Width="20" Fill="#C0C0C0" MouseLeftButtonDown="quadrato_MouseLeftButtonDown"/>

                        <!-- RIGA 6 -->
                        <Rectangle HorizontalAlignment="Left" Height="20" Margin="10,135,0,0" Stroke="Black" VerticalAlignment="Top" Width="20" Fill="#FF0080" MouseLeftButtonDown="quadrato_MouseLeftButtonDown"/>
                        <Rectangle HorizontalAlignment="Left" Height="20" Margin="160,135,0,0" Stroke="Black" VerticalAlignment="Top" Width="20" Fill="#FF8000" MouseLeftButtonDown="quadrato_MouseLeftButtonDown"/>
                        <Rectangle HorizontalAlignment="Left" Height="20" Margin="135,135,0,0" Stroke="Black" VerticalAlignment="Top" Width="20" Fill="#80FF00" MouseLeftButtonDown="quadrato_MouseLeftButtonDown"/>
                        <Rectangle HorizontalAlignment="Left" Height="20" Margin="110,135,0,0" Stroke="Black" VerticalAlignment="Top" Width="20" Fill="#00FF80" MouseLeftButtonDown="quadrato_MouseLeftButtonDown"/>
                        <Rectangle HorizontalAlignment="Left" Height="20" Margin="85,135,0,0" Stroke="Black" VerticalAlignment="Top" Width="20" Fill="#0080FF" MouseLeftButtonDown="quadrato_MouseLeftButtonDown"/>
                        <Rectangle HorizontalAlignment="Left" Height="20" Margin="60,135,0,0" Stroke="Black" VerticalAlignment="Top" Width="20" Fill="#8000FF" MouseLeftButtonDown="quadrato_MouseLeftButtonDown"/>
                        <Rectangle HorizontalAlignment="Left" Height="20" Margin="35,135,0,0" Stroke="Black" VerticalAlignment="Top" Width="20" Fill="#FF00FF" MouseLeftButtonDown="quadrato_MouseLeftButtonDown"/>
                        <Rectangle HorizontalAlignment="Left" Height="20" Margin="185,135,0,0" Stroke="Black" VerticalAlignment="Top" Width="20" Fill="#00FFFF" MouseLeftButtonDown="quadrato_MouseLeftButtonDown"/>

                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="personalizzati">
                <Grid Background="#FFE5E5E5">
                    <Image x:Name="ImageColore" HorizontalAlignment="Left" Height="220" VerticalAlignment="Center" Width="221" Source="Immagini/RGB_ColorSpectrum.png" Stretch="Fill" MouseDown="Image_MouseDown" MouseMove="Image_MouseMove"/>
                    <Grid HorizontalAlignment="Left" Margin="221,0,0,0" Width="37" Height="220" VerticalAlignment="Center">
                        <Rectangle x:Name="modifica_opacità" HorizontalAlignment="Center" Height="184" Stroke="Black" VerticalAlignment="Top" Width="16" Margin="0,10,0,0">
                            <Rectangle.Fill>
                                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                    <GradientStop Color="Black" Offset="0"/>
                                    <GradientStop Color="White" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Slider x:Name="slider_op" HorizontalAlignment="Center" Height="184" VerticalAlignment="Top" Width="24" Orientation="Vertical" Cursor="Arrow" Foreground="{x:Null}" Margin="0,10,0,0" Maximum="255" Value="255" ValueChanged="slider_op_ValueChanged">
                            <Slider.Template>
                                <ControlTemplate TargetType="{x:Type Slider}">
                                    <Grid>

                                        <!-- Track -->
                                        <Track x:Name="PART_Track">
                                            <Track.Thumb>
                                                <Thumb Width="16" Height="16">
                                                    <Thumb.Template>
                                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                                            <Rectangle Fill="Transparent" Height="10" Width="22" Stroke="Black" StrokeThickness="2" Margin="-6,3,-6,3"/>
                                                        </ControlTemplate>
                                                    </Thumb.Template>
                                                </Thumb>
                                            </Track.Thumb>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Slider.Template>
                        </Slider>
                        <Rectangle x:Name="q_colore" HorizontalAlignment="Center" Margin="0,199,0,1" Stroke="Black" Width="20" Height="20"/>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <Border BorderBrush="{x:Null}" BorderThickness="1" HorizontalAlignment="Left" Margin="299,0,0,0" CornerRadius="20,0,0,20" Style="{StaticResource GlassPanelStyle}" Width="201" Grid.ColumnSpan="2">
            <Grid HorizontalAlignment="Center" Width="132" Margin="0,0,0,-1" Height="274" VerticalAlignment="Bottom">
                <Label Content="Red" HorizontalAlignment="Left" VerticalAlignment="Top" Width="44" Height="26" FontSize="13" Margin="-2,24,0,0"/>
                <Label Content="Green:" HorizontalAlignment="Left" Margin="-2,56,0,0" VerticalAlignment="Top" FontSize="13" Width="44" Height="26" />
                <Label Content="Blue" HorizontalAlignment="Left" VerticalAlignment="Top" Width="44" FontSize="13" Height="24" Margin="-2,90,0,0"/>
                <TextBox x:Name="red_text" HorizontalAlignment="Left" Height="26" TextWrapping="Wrap" Text="0" VerticalAlignment="Top" Width="80" BorderThickness="0,0,0,2" Padding="0,5,0,0" Margin="44,24,0,0" BorderBrush="Red" Background="{x:Null}" TextChanged="red_text_TextChanged"/>
                <TextBox x:Name="green_text" HorizontalAlignment="Left" Height="26" Margin="44,56,0,0" TextWrapping="Wrap" Text="0" VerticalAlignment="Top" Width="80" BorderThickness="0,0,0,2" BorderBrush="Lime" Padding="0,5,0,0" Background="{x:Null}" TextChanged="green_text_TextChanged"/>
                <TextBox x:Name="blue_text" HorizontalAlignment="Left" Height="26" TextWrapping="Wrap" Text="0" VerticalAlignment="Top" Width="80" BorderThickness="0,0,0,2" BorderBrush="Blue" Padding="0,5,0,0" Margin="44,88,0,0" Background="{x:Null}" TextChanged="blu_text_TextChanged"/>
                <Label Content="Hex" HorizontalAlignment="Left" Margin="-2,0,0,0" VerticalAlignment="Center" Width="44" FontSize="13" Height="26"/>
                <TextBox x:Name="hex_text" HorizontalAlignment="Left" Height="26" Margin="42,0,0,0" TextWrapping="Wrap" Text="#000000" VerticalAlignment="Center" Width="80" BorderThickness="0,0,0,2" BorderBrush="Black" Padding="0,5,0,0" Background="{x:Null}" TextChanged="hex_text_TextChanged"/>
                <Button Content="Conferma" HorizontalAlignment="Center" Margin="0,225,0,0" VerticalAlignment="Top" Width="134" Background="#4C00FF56" Click="Conferma_Button_Click" BorderBrush="{x:Null}">
                    <Button.Resources>

                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Content="Annulla" HorizontalAlignment="Center" Margin="0,250,0,0" Width="70" FontSize="9" Background="#19E82020" Click="Button_Click" BorderBrush="{x:Null}" Padding="1,0,1,1" Height="14" VerticalAlignment="Top">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Rectangle x:Name="new_color" HorizontalAlignment="Left" Height="24" Margin="66,180,0,0" VerticalAlignment="Top" Width="58" Fill="#FFE2C1C1"/>
                <Rectangle x:Name="old_color" HorizontalAlignment="Left" Height="24" Margin="8,180,0,0" VerticalAlignment="Top" Width="58" Fill="White"/>
            </Grid>
        </Border>

    </Grid>
</Window>
