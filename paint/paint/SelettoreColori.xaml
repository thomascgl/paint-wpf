<Window x:Class="paint.SelettoreColori"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:paint"
        mc:Ignorable="d"
        Title="Selettore Colori" Height="400" Width="500">
    <Grid>
        <Label Content="DA FINIRE, questa è una demo grafica" HorizontalAlignment="Center" VerticalAlignment="Top" HorizontalContentAlignment="Center" Height="40" Width="500" FontSize="22"/>
        <Image HorizontalAlignment="Center" Height="156" Margin="0,60,0,0" VerticalAlignment="Top" Width="269" Source="Immagini/RGB_ColorSpectrum.png" Stretch="Fill"/>
        <Label Content="Rosso" HorizontalAlignment="Left" Margin="64,246,0,0" VerticalAlignment="Top"/>
        <Label Content="Verde" HorizontalAlignment="Left" Margin="64,277,0,0" VerticalAlignment="Top"/>
        <Label Content="Blu" HorizontalAlignment="Left" Margin="64,308,0,0" VerticalAlignment="Top"/>
        <TextBox HorizontalAlignment="Left" Margin="130,246,0,0" TextWrapping="Wrap" Text="0" VerticalAlignment="Top" Width="69" Height="26"/>
        <TextBox HorizontalAlignment="Left" Margin="130,277,0,0" TextWrapping="Wrap" Text="0" VerticalAlignment="Top" Width="69" Height="26"/>
        <TextBox HorizontalAlignment="Left" Margin="130,308,0,0" TextWrapping="Wrap" Text="0" VerticalAlignment="Top" Width="69" Height="26"/>
        <Button Content="Conferma" HorizontalAlignment="Left" Margin="65,339,0,0" VerticalAlignment="Top" Width="134" Background="#FF00FA23" Click="Conferma_Button_Click"/>

    </Grid>
</Window>
